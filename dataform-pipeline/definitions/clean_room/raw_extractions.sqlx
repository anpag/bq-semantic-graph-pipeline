config {
  type: "view",
  schema: "kg_graph_staging",
  name: "raw_extractions",
  description: "Landing view reading raw JSON output from the Extraction Agent landing table."
}

SELECT
  source_file AS file_id,
  1 AS page_num, -- Adding dummy page num for compatibility if needed, or omit if not required downstream
  TO_JSON_STRING(extracted_nodes) AS extracted_nodes,
  TO_JSON_STRING(extracted_edges) AS extracted_edges,
  TO_JSON_STRING(unbound_knowledge) AS unbound_knowledge
FROM
  `semantic-graph-demo.kg_graph_staging.raw_extractions_landing`
