config {
  type: "operations",
  hasOutput: true,
  schema: "semantic_ontology_graph_data",
  name: "extract_aliases",
  description: "Extracts SKOS aliases from the document master record entity dictionary.",
  dependencies: ["document_master_record"]
}

-- 1. Create Alias Nodes
CREATE OR REPLACE TABLE `${dataform.projectConfig.defaultDatabase}.semantic_ontology_graph_data.node_aliases` AS
WITH unnested_synonyms AS (
  SELECT DISTINCT
    TRIM(synonym) AS alias_name
  FROM ${ref("document_master_record")},
  UNNEST(JSON_EXTRACT_ARRAY(pipeline_lineage_tags, '$.entity_dictionary')) AS entity,
  UNNEST(JSON_EXTRACT_STRING_ARRAY(entity, '$.synonyms_used_in_text')) AS synonym
  WHERE synonym IS NOT NULL AND TRIM(synonym) != ''
)
SELECT 
  TO_HEX(MD5(UPPER(alias_name))) AS node_id,
  alias_name AS name,
  'Alias' AS ontology_class
FROM unnested_synonyms;

-- 2. Create CloseMatch Edges
CREATE OR REPLACE TABLE `${dataform.projectConfig.defaultDatabase}.semantic_ontology_graph_data.edge_close_match` AS
WITH unnested_entities AS (
  SELECT DISTINCT
    TRIM(JSON_EXTRACT_SCALAR(entity, '$.canonical_name')) AS canonical_name,
    TRIM(synonym) AS alias_name
  FROM ${ref("document_master_record")},
  UNNEST(JSON_EXTRACT_ARRAY(pipeline_lineage_tags, '$.entity_dictionary')) AS entity,
  UNNEST(JSON_EXTRACT_STRING_ARRAY(entity, '$.synonyms_used_in_text')) AS synonym
  WHERE synonym IS NOT NULL AND TRIM(synonym) != ''
    AND JSON_EXTRACT_SCALAR(entity, '$.canonical_name') IS NOT NULL
)
SELECT 
  GENERATE_UUID() AS edge_id,
  TO_HEX(MD5(UPPER(alias_name))) AS source_node_id,
  TO_HEX(MD5(UPPER(canonical_name))) AS target_node_id,
  'closeMatch' AS relationship_type
FROM unnested_entities;
