config {
  type: "operations",
  hasOutput: true,
  schema: "kg_knowledge_hub",
  name: "route_landing_files",
  description: "AI Router that processes all new files natively bypassing signed-links using AI.GENERATE.",
  dependencies: ["raw_landing_objects", "document_master_record"]
}

INSERT INTO ${ref("document_master_record")} 
(file_id, original_filename, gcs_landing_uri, submitter_id, processing_status, pipeline_lineage_tags)
WITH new_files AS (
  SELECT 
    uri,
    ARRAY_REVERSE(SPLIT(uri, '/'))[OFFSET(0)] as original_filename
  FROM ${ref("raw_landing_objects")}
  WHERE uri NOT IN (SELECT gcs_landing_uri FROM ${ref("document_master_record")} WHERE gcs_landing_uri IS NOT NULL)
),
ai_processing AS (
  SELECT 
    uri as gcs_landing_uri,
    original_filename,
    AI.GENERATE(
      prompt => STRUCT(
        OBJ.MAKE_REF(uri) AS document,
        """
        You are an Enterprise Knowledge Graph Architect. Read this entire document.
        
        TASK: Build a Master Entity Dictionary for this document.
        Identify the primary entities (Molecules, Solvents, Reagents, Equipment, Diseases, Assays) discussed.
        For each entity, determine its strict Canonical Name (e.g., 'Toluene').
        Identify ANY synonyms, acronyms, or lot numbers used in the text to refer to that entity (e.g., 'Toluol', 'lot_123').
        
        Output ONLY a valid JSON object matching this schema:
        {
          "global_context_summary": "A 1-2 sentence technical summary of the document's purpose.",
          "primary_ontology_class": "The overarching type of document (e.g., Experiment_Report, SOP, Equipment_Manual)",
          "entity_dictionary": [
            {
              "canonical_name": "String (The standard scientific name)",
              "ontology_class": "String (choose from: chemical entity, material entity, device, assay, data item, process)",
              "synonyms_used_in_text": ["String"]
            }
          ]
        }
        """ AS text
      ),
      output_schema => 'global_context_summary STRING, primary_ontology_class STRING, entity_dictionary ARRAY<STRUCT<canonical_name STRING, ontology_class STRING, synonyms_used_in_text ARRAY<STRING>>>',
      endpoint => 'gemini-2.5-pro',
      connection_id => '${dataform.projectConfig.vars.connection_id}',
      model_params => JSON '{"generationConfig": {"temperature": 0.2, "maxOutputTokens": 8192}}'
    ) AS ai_output
  FROM new_files
)
SELECT
  GENERATE_UUID() as file_id,
  original_filename,
  gcs_landing_uri,
  'ai_router' as submitter_id,
  'ROUTED' as processing_status,
  PARSE_JSON(JSON_VALUE(ai_output.full_response, '$.candidates[0].content.parts[0].text')) as pipeline_lineage_tags
FROM ai_processing;