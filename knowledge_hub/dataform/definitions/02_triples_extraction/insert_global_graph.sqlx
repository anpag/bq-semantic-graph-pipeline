config {
  type: "operations",
  hasOutput: true,
  schema: "kg_graph_data",
  name: "insert_global_graph",
  description: "Merge generic extracted nodes and edges from page level extractions.",
  dependencies: ["page_level_extractions", "global_nodes", "global_edges", "embedding_model", "onto_classes", "dlq_semantic_failures"]
}

TRUNCATE TABLE ${ref("global_nodes")};
TRUNCATE TABLE ${ref("global_edges")};

-- 1. Insert Valid Nodes (Relational SHACL Enforcement)
INSERT INTO ${ref("global_nodes")}
(node_id, file_id, page_num, name, ontology_class, properties, unbound_insights, embedding)
WITH unnested_nodes AS (
  SELECT DISTINCT
    file_id,
    page_num,
    node.node_name,
    node.ontology_class,
    node.properties
  FROM ${ref("page_level_extractions")},
  UNNEST(extracted_nodes) AS node
  WHERE node.node_name IS NOT NULL
),
-- Semantic SHACL Check: Only keep nodes that EXACTLY match our parsed Ontology Master Dictionary
validated_nodes AS (
  SELECT u.* 
  FROM unnested_nodes u
  INNER JOIN ${ref("semantic_ontology_graph", "onto_classes")} dict
    ON TRIM(u.ontology_class) = dict.class_name
),
formatted_nodes AS (
  SELECT DISTINCT
    TO_HEX(MD5(UPPER(TRIM(node_name)))) AS node_id,
    file_id,
    page_num,
    TRIM(node_name) AS name,
    TRIM(ontology_class) AS ontology_class,
    properties
  FROM validated_nodes
)
SELECT
  n.node_id,
  n.file_id,
  n.page_num,
  n.name,
  n.ontology_class,
  n.properties,
  p.unbound_insights,
  n.ml_generate_embedding_result AS embedding
FROM ML.GENERATE_EMBEDDING(
  MODEL ${ref("embedding_model")},
  (SELECT node_id, file_id, page_num, name, ontology_class, properties, FORMAT('%s (%s): %s', name, ontology_class, COALESCE(properties, '{}')) AS content FROM formatted_nodes),
  STRUCT(TRUE AS flatten_json_output)
) n
LEFT JOIN ${ref("page_level_extractions")} p
  ON p.file_id = n.file_id AND p.page_num = n.page_num;

-- 2. Insert Hallucinated Nodes into Semantic DLQ
INSERT INTO ${ref("dlq_semantic_failures")}
(file_id, page_num, node_name, hallucinated_class, properties)
WITH unnested_nodes AS (
  SELECT DISTINCT
    file_id,
    page_num,
    node.node_name,
    node.ontology_class,
    node.properties
  FROM ${ref("page_level_extractions")},
  UNNEST(extracted_nodes) AS node
  WHERE node.node_name IS NOT NULL
)
SELECT 
  file_id, page_num, node_name, ontology_class AS hallucinated_class, properties
FROM unnested_nodes u
WHERE TRIM(u.ontology_class) NOT IN (SELECT class_name FROM ${ref("semantic_ontology_graph", "onto_classes")});

-- 3. Insert Edges
INSERT INTO ${ref("global_edges")}
(edge_id, source_node_id, target_node_id, relationship_type, evidence_insight, confidence_score)
SELECT DISTINCT
  GENERATE_UUID() AS edge_id,
  TO_HEX(MD5(UPPER(TRIM(edge.source_node_name)))) AS source_node_id,
  TO_HEX(MD5(UPPER(TRIM(edge.target_node_name)))) AS target_node_id,
  TRIM(edge.ontological_relationship) AS relationship_type,
  edge.evidence_insight,
  edge.confidence_score
FROM ${ref("page_level_extractions")},
UNNEST(extracted_edges) AS edge
WHERE edge.source_node_name IS NOT NULL AND edge.target_node_name IS NOT NULL;