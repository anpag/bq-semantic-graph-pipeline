config {
  type: "operations",
  hasOutput: true,
  schema: "kg_knowledge_hub",
  name: "kg_graph",
  description: "The primary KG Knowledge Hub Property Graph (Unified Schema).",
  dependencies: [
    "document_master_record",
    "global_nodes",
    "global_edges"
  ]
}

CREATE OR REPLACE PROPERTY GRAPH ${self()}
  NODE TABLES (
    `${dataform.projectConfig.defaultDatabase}.kg_graph_data.global_nodes` KEY(node_id),
    `${dataform.projectConfig.defaultDatabase}.kg_knowledge_hub.document_master_record` KEY(file_id)
  )
  EDGE TABLES (
    `${dataform.projectConfig.defaultDatabase}.kg_graph_data.global_edges` KEY(edge_id)
      SOURCE KEY(source_node_id) REFERENCES `${dataform.projectConfig.defaultDatabase}.kg_graph_data.global_nodes`(node_id)
      DESTINATION KEY(target_node_id) REFERENCES `${dataform.projectConfig.defaultDatabase}.kg_graph_data.global_nodes`(node_id)
      LABEL CONNECTS
  );