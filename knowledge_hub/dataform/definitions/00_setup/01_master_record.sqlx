config {
  type: "operations",
  hasOutput: true,
  schema: "kg_knowledge_hub",
  name: "document_master_record",
  description: "Foundational master record tracking data lineage and processing status for all ingested files."
}

CREATE TABLE IF NOT EXISTS ${self()} (
    file_id STRING NOT NULL,
    original_filename STRING,
    gcs_landing_uri STRING,
    submitter_id STRING,
    created_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP(),
    processing_status STRING,
    pipeline_lineage_tags JSON
);
