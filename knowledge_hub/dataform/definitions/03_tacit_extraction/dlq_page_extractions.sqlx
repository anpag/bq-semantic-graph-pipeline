config {
  type: "operations",
  hasOutput: true,
  schema: "kg_knowledge_hub",
  name: "dlq_page_extractions",
  description: "Dead-Letter Queue for failed LLM JSON extractions. Catches hallucinations to prevent pipeline crashes."
}

CREATE TABLE IF NOT EXISTS ${self()} (
  file_id STRING,
  original_filename STRING,
  page_num INT64,
  raw_llm_response STRING,
  error_timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP()
);