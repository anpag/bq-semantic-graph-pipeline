config {
  type: "operations",
  hasOutput: true,
  schema: dataform.projectConfig.vars.staging_dataset,
  name: "raw_landing_objects",
  description: "Object table pointing to the raw GCS landing zone, providing the foundation for the AI Router."
}

CREATE EXTERNAL TABLE IF NOT EXISTS ${self()}
WITH CONNECTION `${dataform.projectConfig.vars.connection_id}`
OPTIONS (
  object_metadata = 'SIMPLE',
  uris = ['gs://${dataform.projectConfig.vars.gcs_bucket}/01_landing/*']
);
